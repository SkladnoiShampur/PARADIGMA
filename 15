# =============================================================================
# Лабораторная работа №26
# Расчёт Impression Share (импрешн-шер) и потенциала роста
# Кластер запросов: «ноутбук»
# =============================================================================

# --- Исходные данные из задания ----------------------------------------------
# Фактические показы сайта за месяц (Google Search Console)
actual_impressions = 24_600

# Общий поисковый объём кластера запросов, показов/мес.
# В задании это принимается за «потенциальные показы» (Potential Impressions)
total_search_volume = 148_000

# Целевой Impression Share, %
target_is_percent = 30.0


# =============================================================================
# ТЕОРЕТИЧЕСКИЙ ВОПРОС
# Что такое Impression Share (IS) в органическом SEO?
# Чем отличается от метрики в контекстной рекламе (Google Ads)?
# =============================================================================
print("=" * 70)
print("ТЕОРЕТИЧЕСКИЙ ВОПРОС")
print("=" * 70)
print("""
Impression Share (IS) — доля показов, которую сайт получает
относительно «потенциала» показов по выбранному набору запросов.

В ОРГАНИЧЕСКОМ SEO (оценочная метрика):
  • IS = (Фактические показы / Потенциальные показы) × 100%
  • Потенциальные показы часто оценивают через суммарный
    поисковый объём кластера (как в этой работе: 148 000 запросов/мес.)
  • Зависит от позиций в выдаче, охвата семантики, индексации,
    сниппета, CTR и конкуренции.
  • Это не «официальная» метрика GSC, а аналитическая оценка
    потенциала роста органического трафика.

В GOOGLE ADS (официальная метрика аукциона):
  • IS = доля показов ваших объявлений от всех возможных показов
    по ключам (с учётом таргетинга, ставок, бюджета, качества).
  • «Упущенные» показы делят на: бюджет, ставку/ранг, таргетинг.
  • Потенциал ограничен аукционом и настройками кампании,
    а не только поисковым объёмом.

ГЛАВНОЕ ОТЛИЧИЕ:
  В SEO IS — модель «сколько показов мы могли бы получить
  при полном охвате кластера»; в Ads — «какую долю аукциона
  мы реально выиграли» при текущих ставках и бюджете.
""")
print()


# =============================================================================
# ФОРМУЛЫ
# IS (%) = (Фактические показы / Потенциальные показы) × 100%
# Потенциальные показы = total_search_volume (148 000)
# =============================================================================


# --- Аналитический вопрос 1: текущий Impression Share ------------------------
current_is = (actual_impressions / total_search_volume) * 100
# Округление IS до двух знаков после запятой (по условию задания)
current_is_rounded = round(current_is, 2)


# --- Аналитический вопрос 2: прирост показов для IS = 30% -------------------
# Сколько показов нужно при 30% IS:
target_impressions = total_search_volume * (target_is_percent / 100)

# На сколько нужно увеличить показы (округляем до целого числа)
impressions_increase = round(target_impressions - actual_impressions)


# =============================================================================
# ВЫВОД РАСЧЁТОВ
# =============================================================================
print("=" * 70)
print("РАСЧЁТЫ")
print("=" * 70)

print(f"Фактические показы (GSC):     {actual_impressions:,} показов/мес.".replace(",", " "))
print(f"Потенциальные показы (объём): {total_search_volume:,} показов/мес.".replace(",", " "))
print()

print("--- Шаг 1. Текущий Impression Share ---")
print(f"IS = ({actual_impressions} / {total_search_volume}) × 100%")
print(f"IS = {current_is_rounded}%")
print()

print("--- Шаг 2. Целевые показы при IS = 30% ---")
print(f"Целевые показы = {total_search_volume} × 0,30 = {int(target_impressions):,} показов/мес.".replace(",", " "))
print()

print("--- Шаг 3. Необходимый прирост показов ---")
print(f"Прирост = {int(target_impressions):,} - {actual_impressions:,} = {impressions_increase:,} показов/мес.".replace(",", " "))
print()


# =============================================================================
# АНАЛИТИЧЕСКИЙ ВОПРОС 3: Тактика достижения 30% IS
# =============================================================================
print("=" * 70)
print("АНАЛИТИЧЕСКИЙ ВОПРОС 3 — ТАКТИКА ДОСТИЖЕНИЯ 30% IS")
print("=" * 70)
print("""
1. Расширение семантики
   Добавить страницы под длинный хвост кластера «ноутбук»,
   которые закрывают конкуренты, а наш сайт — нет
   (сравнение моделей, подбор по задачам, обзоры, FAQ).

2. Улучшение позиций по существующим запросам
   Перевести ключевые страницы с позиций 8–15 в зону 3–7:
   доработка контента, внутренняя перелинковка,
   улучшение title/description, скорость и UX.

3. Контент под низкочастотные запросы (НЧ)
   Создать целевые материалы под НЧ-запросы кластера
   с низкой конкуренцией — быстрый прирост показов
   при меньших затратах на продвижение.
""")
print()


# =============================================================================
# ИТОГОВЫЙ ОТВЕТ (как в эталонном решении)
# =============================================================================
print("=" * 70)
print("ИТОГОВЫЙ ОТВЕТ")
print("=" * 70)
print(
    f"IS = {current_is_rounded}%; "
    f"для достижения 30% IS необходим прирост на "
    f"{impressions_increase:,} показов/мес.".replace(",", " ")
)
