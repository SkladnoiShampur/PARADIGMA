import sys
import time

def merge_sorted_arrays(arr1, arr2):
    """
    Сливает два отсортированных массива arr1 (длина n) и arr2 (длина m)
    в один отсортированный массив.
    Временная сложность: O(n + m)
    Пространственная сложность: O(n + m)
    """
    start = time.time()
    n, m = len(arr1), len(arr2)
    merged = [] 
    i, j = 0, 0 # Указатели для arr1 и arr2

    while i < n and j < m:
        if arr1[i] <= arr2[j]:
            merged.append(arr1[i])
            i += 1
        else:
            merged.append(arr2[j])
            j += 1

    while i < n:
        merged.append(arr1[i])
        i += 1
    while j < m:
        merged.append(arr2[j])
        j += 1

    execution_time = time.time() - start
    memory_usage = sys.getsizeof(merged) + sys.getsizeof(arr1) + sys.getsizeof(arr2)
    return merged, execution_time, memory_usage

def analyze_complexity():
    sizes = [(100, 150), (500, 750), (1000, 1500), (2000, 3000)] # Пары (n, m)
    execution_times = []
    memory_usages = []

    print("АНАЛИЗ ВРЕМЕННОЙ И ПРОСТРАНСТВЕННОЙ СЛОЖНОСТИ")
    print("Размер arr1\tРазмер arr2\tВремя (сек)\tТеор. время (сек)\tПамять (байт)\tТеор. память (байт)")

    for n, m in sizes:
        # Генерируем тестовые данные
        arr1 = list(range(0, n)) # Отсортированный массив длины n
        arr2 = list(range(n, n + m)) # Отсортированный массив длины m

        merged, exec_time, mem_usage = merge_sorted_arrays(arr1, arr2)
        execution_times.append(exec_time)
        memory_usages.append(mem_usage)

        # 1. Берем только первый кортеж из списка sizes как базовый для сравнения
        base_n, base_m = sizes[0] 
        
        # 2. Используем первый замер времени и памяти как эталон (base_time / base_mem)
        theoretical_time = ((n + m) / (base_n + base_m)) * execution_times[0]
        theoretical_mem = ((n + m) / (base_n + base_m)) * memory_usages[0]

        print(f"{n}\t\t{m}\t\t{exec_time:.6f}\t\t{theoretical_time:.6f}\t\t{mem_usage}\t\t{theoretical_mem:.0f}")

    return execution_times, memory_usages


if __name__ == "__main__":
    arr1 = [1, 3, 5, 7, 9]
    arr2 = [2, 4, 6, 8, 10, 11, 12]
    print("Исходный массив 1:", arr1)
    print("Исходный массив 2:", arr2)
    
    result, exec_time, mem_usage = merge_sorted_arrays(arr1, arr2)
    
    print("Результат слияния:", result)
    analyze_complexity()
