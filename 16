# =============================================================================
# Задание 8. CPI и ROI в мобильном маркетинге
# =============================================================================

# -----------------------------------------------------------------------------
# Часть 1. Теория: что такое CPI (Cost Per Install)
# -----------------------------------------------------------------------------
# CPI (Cost Per Install) — стоимость одной установки приложения.
# Формула: CPI = расходы на рекламу / количество установок.
#
# Особенности метрики:
# - Считается только по факту установки приложения (не клик, не показ).
# - Позволяет сравнивать каналы закупки трафика по цене привлечения пользователя.
# - В мобильном маркетинге установка — ключевое действие воронки: без install
#   пользователь не попадает в продукт (игра, банк, доставка и т.д.).
#
# Пример рекламодателя, для которого CPI критичен:
# разработчик мобильной игры (free-to-play), который платит за установки
# в рекламных сетях (Google Ads, Facebook, TikTok) и окупает их внутриигровыми
# покупками и рекламой.

# -----------------------------------------------------------------------------
# Часть 2. Расчёт по условию задачи
# -----------------------------------------------------------------------------
# Потрачено: 200 000 ₽, установок: 5 000, доход с одной установки: 60 ₽
#
# CPI = 200 000 / 5 000 = 40 ₽ за установку
# Общий доход = 5 000 × 60 = 300 000 ₽
# Прибыль = 300 000 − 200 000 = 100 000 ₽ > 0
# Вывод: рекламная кампания окупается.

def calculate_cpi(spend, installs):
    """
    Считает CPI — стоимость одной установки приложения.

    spend    — расходы на рекламу (руб.)
    installs — количество установок
    """
    if installs == 0:
        raise ValueError("Количество установок не может быть равно нулю")
    return spend / installs


def cpi_roi_analysis(spend, installs, revenue_per_install):
    """
    Анализ кампании: CPI, общий доход, абсолютный ROI и статус окупаемости.

    spend                — расходы на рекламу (руб.)
    installs             — количество установок
    revenue_per_install  — средний доход с одной установки (руб.)
    """
    cpi = calculate_cpi(spend, installs)
    total_revenue = installs * revenue_per_install
    roi_absolute = total_revenue - spend

    # Кампания окупается, если доход не меньше расходов
    if roi_absolute >= 0:
        status = "Окупается"
    else:
        status = "Не окупается"

    return {
        "cpi": cpi,
        "total_revenue": total_revenue,
        "roi_absolute": roi_absolute,
        "status": status,
    }


# -----------------------------------------------------------------------------
# Часть 4. Проверка (тесты из задания)
# -----------------------------------------------------------------------------
if __name__ == "__main__":
    # Тест 1: CPI
    cpi_result = calculate_cpi(200000, 5000)
    print("calculate_cpi(200000, 5000) =", cpi_result)
    assert cpi_result == 40.0, "Ошибка: CPI должен быть 40.0"

    # Тест 2: полный анализ ROI
    analysis = cpi_roi_analysis(200000, 5000, 60)
    print("cpi_roi_analysis(200000, 5000, 60) =", analysis)

    expected = {
        "cpi": 40.0,
        "total_revenue": 300000,
        "roi_absolute": 100000,
        "status": "Окупается",
    }
    assert analysis == expected, "Ошибка: результат не совпадает с ожидаемым"

    print("\nВсе тесты пройдены успешно!")
