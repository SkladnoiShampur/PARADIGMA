## Реализуйте edmonds_karp(graph, source, sink) → max_flow.
## Алгоритм:
## 1. BFS для нахождения кратчайшего увеличивающего пути (по числу рёбер)
## 2. Обновить остаточные пропускные способности вдоль пути
## 3. Повторять, пока путь от source до sink существует
## Граф (u, v, пропускная способность), s=0, t=5:
## [(0,1,16),(0,2,13),(1,2,10),(1,3,12),
##  (2,4,14),(3,2,9),(3,5,20),(4,3,7),(4,5,4)]
## Найдите максимальный поток. Выведите поток по каждому ребру.
## Найдите минимальный разрез. Объясните теорему max-flow min-cut.
## Сложность: O(V·E²).

from collections import deque, defaultdict

def bfs(C, F, source, sink):
    queue = deque([source])
    paths = {source: []}
    while queue:
        u = queue.popleft()
        for v in C[u]:
            if C[u][v] - F[u][v] > 0 and v not in paths:
                paths[v] = paths[u] + [(u, v)]
                if v == sink:
                    return paths[v]
                queue.append(v)
    return None

def edmonds_karp(C, source, sink):
    n = len(C)
    F = defaultdict(lambda: defaultdict(int))
    max_flow = 0
    while True:
        path = bfs(C, F, source, sink)
        if not path:
            break
        flow = min(C[u][v] - F[u][v] for u, v in path)
        for u, v in path:
            F[u][v] += flow
            F[v][u] -= flow
        max_flow += flow
    return max_flow, F

C = {
    0: {1: 16, 2: 13},
    1: {2: 10, 3: 12},
    2: {4: 14},
    3: {2: 9, 5: 20},
    4: {3: 7, 5: 4}
}

source = 0
sink = 5

max_flow, F = edmonds_karp(C, source, sink)

for u in F:
    for v in F[u]:
        if F[u][v] != 0:
            print(f"Поток {F[u][v]} от {u} к {v}")

print(max_flow, F)
