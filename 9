// Реализуйте двоичное дерево поиска (BST) процедурно.
// Узел: {'val': v, 'left': None, 'right': None}
// Функции:
// 1. bst_insert(root, val) → root
// 2. bst_search(root, val) → True/False
// 3. bst_inorder(root) → список (L-Node-R)
// 4. bst_height(root) → высота
// 5. bst_count(root) → количество узлов
// Вставьте: [5, 3, 7, 1, 4, 6, 8, 2]

def bst_insert(root, val):
    # Если дерево пустое — создаём новый узел
    if root is None:
        return {'val': val, 'left': None, 'right': None}
    # Если значение меньше текущего — вставляем в левое поддерево
    if val < root['val']:
        root['left'] = bst_insert(root['left'], val)
    # Если значение больше или равно — вставляем в правое поддерево
    elif val > root['val']:
        root['right'] = bst_insert(root['right'], val)
    # Возвращаем корень дерева (может быть обновлён)
    return root


def bst_search(root, val):
    # Если дерево пустое — элемента нет
    if root is None:
        return False
    # Если нашли значение — возвращаем True
    if root['val'] == val:
        return True
    # Если значение меньше текущего — ищем в левом поддереве
    elif val < root['val']:
        return bst_search(root['left'], val)
    # Если значение больше — ищем в правом поддереве
    else:
        return bst_search(root['right'], val)


def bst_inorder(root):
    # Результат обхода в порядке L-Node-R (слева — узел — справа)
    result = []
    # Если дерево не пустое, рекурсивно обходим
    if root is not None:
        # Сначала обходим левое поддерево
        result.extend(bst_inorder(root['left']))
        # Добавляем текущий узел
        result.append(root['val'])
        # Затем обходим правое поддерево
        result.extend(bst_inorder(root['right']))
    return result


def bst_height(root):
    # Высота пустого дерева равна 0
    if root is None:
        return 0
    # Рекурсивно находим высоту левого и правого поддеревьев
    left_height = bst_height(root['left'])
    right_height = bst_height(root['right'])
    # Высота дерева — максимум из высот поддеревьев + 1 (корень)
    return max(left_height, right_height) + 1


def bst_count(root):
    # Количество узлов в пустом дереве — 0
    if root is None:
        return 0
    # Рекурсивно считаем узлы в левом и правом поддеревьях
    # и прибавляем 1 (текущий узел)
    return 1 + bst_count(root['left']) + bst_count(root['right'])


# Вставка элементов в дерево
root = None
for val in [5, 3, 7, 1, 4, 6, 8, 2]:
    root = bst_insert(root, val)

# Проверка функций
inorder_result = bst_inorder(root)
height_result = bst_height(root)
count_result = bst_count(root)

print("in-order:", inorder_result)  # Ожидаемый результат: [1, 2, 3, 4, 5, 6, 7, 8]
print("bst_height:", height_result)  # Ожидаемый результат: 4
print("bst_count:", count_result)  # Ожидаемый результат: 8

