# ==================== Класс Person (уровень 1) ====================
class Person:
    def __init__(self, name, age):
        """Конструктор Person"""
        self.name = name
        self.age = age
        print("Person: __init__ вызван")
    
    def greet(self):
        """Метод приветствия"""
        print(f"Привет, я {self.name}")
    
    def info(self):
        """Метод вывода информации"""
        print(f"Имя: {self.name}, Возраст: {self.age}")
    
    def __str__(self):
        """Переопределенный __str__ - добавляем свою часть, не дублируя родителя"""
        return f"Person[{self.name}, {self.age}]"


# ==================== Класс Employee (уровень 2) ====================
class Employee(Person):
    def __init__(self, name, age, company, salary):
        """Конструктор Employee с использованием super()"""
        super().__init__(name, age)  # Вызов конструктора Person
        self.company = company
        self.salary = salary
        print("Employee: __init__ вызван")
    
    def work(self):
        """Метод работы"""
        print(f"{self.name} работает в компании {self.company}")
    
    def get_salary(self):
        """Метод получения зарплаты"""
        return self.salary
    
    def __str__(self):
        """Переопределенный __str__ - добавляем свою часть, не дублируя родителя"""
        return f"{super().__str__()} | Employee[{self.company}, {int(self.salary)}₽]"


# ==================== Класс Manager (уровень 3) ====================
class Manager(Employee):
    def __init__(self, name, age, company, salary, department, team_size):
        """Конструктор Manager с использованием super()"""
        super().__init__(name, age, company, salary)  # Вызов конструктора Employee
        self.department = department
        self.team_size = team_size
        print("Manager: __init__ вызван")
    
    def manage(self):
        """Метод управления отделом"""
        print(f"{self.name} управляет отделом {self.department}")
    
    def hire(self, employee_name):
        """Метод найма сотрудников"""
        print(f"{self.name} нанимает сотрудника {employee_name}")
    
    def __str__(self):
        """Переопределенный __str__ - добавляем свою часть"""
        return f"{super().__str__()} | Manager[{self.department}, {self.team_size}чел]"


# ==================== Класс Director (уровень 4) ====================
class Director(Manager):
    def __init__(self, name, age, company, salary, department, team_size, budget):
        """Конструктор Director с использованием super()"""
        super().__init__(name, age, company, salary, department, team_size)  # Вызов конструктора Manager
        self.budget = budget
        print("Director: __init__ вызван")
    
    def approve_budget(self, amount):
        """Метод утверждения бюджета"""
        if amount <= self.budget:
            print(f"Бюджет в размере {amount}₽ утвержден")
            self.budget -= amount
        else:
            print(f"Отказ: недостаточно бюджета")
    
    def annual_report(self):
        """Метод годового отчета"""
        print(f"Годовой отчет: бюджет = {self.budget}₽, отдел = {self.department}")
    
    def __str__(self):
        """Переопределенный __str__ - добавляем свою часть, показывая всю цепочку"""
        return f"{super().__str__()} | Director[бюджет: {int(self.budget/1000000)}М]"


# ==================== Главная часть для демонстрации ====================
if __name__ == "__main__":
