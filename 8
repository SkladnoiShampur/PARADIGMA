// Изучите области видимости в C: локальные, глобальные и статические переменные.
// 48. Что выведет программа при трёх вызовах?
// 49. В чём разница между local_static и обычной local?
// 50. Где в памяти хранятся global_counter, local_static и local? 

#include <stdio.h>

// Глобальная переменная — доступна из любой части программы
// Хранится в сегменте данных (.data)
int global_counter = 0;

void increment() {
    // Статическая локальная переменная — сохраняет своё значение между вызовами функции
    // Инициализируется только один раз при первом вызове функции
    // Хранится в сегменте данных (.data), а не в стеке
    static int local_static = 0;

    // Обычная локальная переменная — создаётся заново при каждом вызове функции
    // Инициализируется значением 0 при каждом входе в функцию
    // Хранится в стеке (stack)
    int local = 0;

    // Увеличение глобальной переменной — изменяет общее значение, доступное везде
    global_counter++;

    // Увеличение статической локальной переменной — сохраняет накопленное значение
    local_static++;

    // Увеличение обычной локальной переменной — сбрасывается при каждом вызове
    local++;
    
    printf("global=%d, static=%d, local=%d\n", global_counter, local_static, local);
}

int main() {
    increment(); 
    increment(); 
    increment(); 

    return 0;
}
