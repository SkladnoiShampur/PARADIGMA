## Сравнение heap sort и merge sort по числу сравнений при n = 20.

import time
import copy
import random
import tracemalloc

def heapify(arr, n, i):
    largest = i
    left = 2 * i + 1
    right = 2 * i + 2

    if left < n and arr[left] > arr[largest]:
        largest = left

    if right < n and arr[right] > arr[largest]:
        largest = right

    if largest != i:
        arr[i], arr[largest] = arr[largest], arr[i]
##        print(f"После heapify (обмен {arr[i]} и {arr[largest]}): {arr}")  
        heapify(arr, n, largest)

def heap_sort(arr):
    n = len(arr)
##    print(f"Исходный массив: {arr}")  

    # Построение max heap
    for i in range(n // 2 - 1, -1, -1):
        heapify(arr, n, i)
 ##       print(f"После heapify (этап построения кучи, i={i}): {arr}")  

    # Извлечение элементов
    for i in range(n - 1, 0, -1):
        arr[0], arr[i] = arr[i], arr[0]
 ##       print(f"После обмена корня ({arr[i]}) с последним элементом: {arr}")  
        heapify(arr, i, 0)
##        print(f"После heapify (этап сортировки, i={i}): {arr}")  
    return arr

def merge_sort(arr):
    if len(arr) <= 1:
##        print(f"Базовый случай (длина <= 1): {arr}")  
        return arr
    mid = len(arr) // 2
    left = merge_sort(arr[:mid])
    right = merge_sort(arr[mid:])
    result = merge(left, right)
##    print(f"После слияния {left} и {right}: {result}")  
    return result

def merge(left, right):
    result = []
    i = j = 0
    while i < len(left) and j < len(right):
        if left[i] < right[j]:
            result.append(left[i])
            i += 1
        else:
            result.append(right[j])
            j += 1
    result.extend(left[i:])
    result.extend(right[j:])
    return result

def count_comparisons_heap(arr):
    comparisons = 0
    n = len(arr)

    def heapify_with_counter(a, size, idx):
        nonlocal comparisons
        largest = idx
        l = 2 * idx + 1
        r = 2 * idx + 2

        if l < size:
            comparisons += 1
            if a[l] > a[largest]:
                largest = l
        if r < size:
            comparisons += 1
            if a[r] > a[largest]:
                largest = r
        if largest != idx:
            a[idx], a[largest] = a[largest], a[idx]
            heapify_with_counter(a, size, largest)

    # Построение кучи
    for i in range(n // 2 - 1, -1, -1):
        heapify_with_counter(arr, n, i)

    # Сортировка
    for i in range(n - 1, 0, -1):
        arr[0], arr[i] = arr[i], arr[0]
        heapify_with_counter(arr, i, 0)
    
    return comparisons

def count_comparisons_merge(arr):
    count = 0
    def sort_and_count(a):
        nonlocal count
        if len(a) <= 1:
            return a
        mid = len(a) // 2
        left = sort_and_count(a[:mid])
        right = sort_and_count(a[mid:])
        
        merged = []
        i = j = 0
        while i < len(left) and j < len(right):
            count += 1 # Реальное сравнение
            if left[i] < right[j]:
                merged.append(left[i])
                i += 1
            else:
                merged.append(right[j])
                j += 1
        merged.extend(left[i:])
        merged.extend(right[j:])
        return merged

    sort_and_count(arr)
    return count

test_array = [64, 34, 25, 12, 22, 11, 90, 88, 76, 50, 42, 37, 30, 28, 13, 10, 9, 8, 7, 1]

# Замеры для Heap Sort
start_time = time.time()
heap_sorted = heap_sort(copy.deepcopy(test_array))
heap_time = time.time() - start_time
h_comps = count_comparisons_heap(copy.deepcopy(test_array))

# Замеры для Merge Sort
start_time = time.time()
merge_sorted = merge_sort(copy.deepcopy(test_array))
merge_time = time.time() - start_time
m_comps = count_comparisons_merge(copy.deepcopy(test_array))

print(f"\n--- РЕЗУЛЬТАТЫ ---")
print(f"Массив отсортирован верно: {heap_sorted == sorted(test_array)}")
print(f"\n[Heap Sort]")
print(f"Время: {heap_time:.6f} сек")
print(f"Сравнений: {h_comps}")

print(f"\n[Merge Sort]")
print(f"Время: {merge_time:.6f} сек")
print(f"Сравнений: {m_comps}\n")

def test_time_complexity():
    sizes = [10, 100, 200]
    print(f"{'n':<10} {'Heap sort (сек)':<20} {'Merge sort (сек)':<20}")
    for n in sizes:
        arr = [random.randint(1, 10000) for _ in range(n)]
        
        # Heap sort
        arr_copy = copy.deepcopy(arr)
        start = time.time()
        heap_sort(arr_copy)
        heap_time = time.time() - start
        
        # Merge sort
        arr_copy = copy.deepcopy(arr)
        start = time.time()
        merge_sort(arr_copy)
        merge_time = time.time() - start
        
        print(f"{n:<10} {heap_time:<20.6f} {merge_time:<20.6f}")

test_time_complexity()

def measure_memory_heap(arr):
    tracemalloc.start()
    heap_sort(copy.deepcopy(arr))
    current, peak = tracemalloc.get_traced_memory()
    tracemalloc.stop()
    print(f"\nHeap sort: пиковая память = {peak / 1024:.2f} КБ")

measure_memory_heap(test_array)
