class TreeNode:
    def __init__(self, key):
        self.key = key
        self.left = None
        self.right = None
        self.height = 1


def get_height(node):
    if not node:
        return 0
    return node.height


def get_balance(node):
    if not node:
        return 0
    return get_height(node.right) - get_height(node.left)


def update_height(node):
    node.height = 1 + max(get_height(node.left), get_height(node.right))


# Правый поворот (Right Rotate)
def right_rotate(y):
    x = y.left
    T2 = x.right

    # Выполняем поворот
    x.right = y
    y.left = T2

    # Обновляем высоты
    update_height(y)
    update_height(x)

    return x  # Новый корень поддерева


# Левый поворот (Left Rotate)
def left_rotate(x):
    y = x.right
    T2 = y.left

    # Выполняем поворот
    y.left = x
    x.right = T2

    # Обновляем высоты
    update_height(x)
    update_height(y)

    return y  # Новый корень поддерева


# Балансировка узла
def balance(node):
    update_height(node)

    balance_factor = get_balance(node)

    # LL случай — правый поворот
    if balance_factor < -1 and get_balance(node.left) <= 0:
        return right_rotate(node)

    # RR случай — левый поворот
    if balance_factor > 1 and get_balance(node.right) >= 0:
        return left_rotate(node)

    # LR случай — сначала левый поворот для левого поддерева, затем правый для узла
    if balance_factor < -1 and get_balance(node.left) > 0:
        node.left = left_rotate(node.left)
        return right_rotate(node)

    # RL случай — сначала правый поворот для правого поддерева, затем левый для узла
    if balance_factor > 1 and get_balance(node.right) < 0:
        node.right = right_rotate(node.right)
        return left_rotate(node)

    return node


# Вставка ключа в AVL-дерево
def insert(node, key):
    # Выполняем обычную вставку как в BST
    if not node:
        return TreeNode(key)
    elif key < node.key:
        node.left = insert(node.left, key)
    else:
        node.right = insert(node.right, key)

    # Балансируем дерево после вставки
    return balance(node)


# Вывод дерева (inorder traversal)
def inorder_traversal(root):
    result = []
    if root:
        result.extend(inorder_traversal(root.left))
        result.append(root.key)
        result.extend(inorder_traversal(root.right))
    return result


# Основная программа
if __name__ == "__main__":
    root = None
    keys = [10, 30, 20, 5, 15, 25, 35]

    for key in keys:
        root = insert(root, key)
        print(f"После вставки {key}: {inorder_traversal(root)}")

    print("Итоговое дерево (inorder):", inorder_traversal(root))
