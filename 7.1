from collections import deque, defaultdict

def bfs(C, F, source, sink):
    """
    Поиск в ширину (BFS) для нахождения кратчайшего увеличивающего пути
    в остаточной сети.
    
    Параметры:
        C: словарь пропускных способностей исходной сети (C[u][v] > 0)
        F: текущий поток (F[u][v] - поток по ребру u->v)
        source: вершина-исток
        sink: вершина-сток
    
    Возвращает:
        Список рёбер (u, v) образующих путь от source до sink,
        или None, если путь не существует.
    """
    queue = deque([source])          # очередь для BFS
    paths = {source: []}             # для каждой вершины храним путь от истока

    while queue:
        u = queue.popleft()          # извлекаем текущую вершину
        # Перебираем всех соседей u в исходном графе (прямые рёбра)
        for v in C[u]:
            # Остаточная пропускная способность = C[u][v] - F[u][v]
            # Положительна → по ребру можно пропустить дополнительный поток
            # Кроме того, обратные рёбра неявно учитываются через F[v][u] < 0,
            # потому что F[v][u] отрицателен, и C[v][u] может отсутствовать,
            # но проверка v in C[u] ограничивает только исходные рёбра? 
            # На самом деле, в нашей реализации BFS просматривает только те вершины,
            # которые есть в C[u]. Это не позволяет использовать обратные рёбра,
            # если они не были изначально в графе. Однако в алгоритме Эдмондса-Карпа
            # обратные рёбра возникают в остаточной сети, и BFS должна их учитывать.
            # Правильнее было бы перебирать всех возможных соседей, которые есть
            # в C[u] или для которых F[u][v] < 0. Но так как C - только прямые,
            # мы можем дополнить граф обратными рёбрами с нулевой пропускной способностью,
            # либо использовать другой подход: хранить остаточную сеть отдельно.
            # В данном коде BFS не видит обратные рёбра, что может привести к ошибке.
            # Исправим: будем перебирать все вершины, для которых есть ненулевая
            # остаточная пропускная способность (через C и F).
            # Для простоты создадим множество всех вершин, но лучше:
            # перебираем v, такие что C[u].get(v,0) - F[u][v] > 0 или F[v][u] < 0.
            # Однако в учебных целях оставим как есть, но добавим комментарий.
            # Более корректная версия:
            # for v in set(C.keys()) | set(F[u].keys()):
            #     residual = C.get(u, {}).get(v, 0) - F[u][v]
            #     if residual > 0 and v not in paths:
            #         ...
            # Но для данного графа, где все обратные рёбра появятся из F,
            # нужно их явно перебирать. Пропустим для краткости, но в решении
            # напишем правильный вариант.
            pass

    # ---- Исправленная реализация BFS, учитывающая обратные рёбра ----
    # Создаём множество всех вершин, которые встречаются в C или F
    all_vertices = set(C.keys()) | set(F.keys())
    for u in list(all_vertices):
        all_vertices.update(C.get(u, {}).keys())
        all_vertices.update(F[u].keys())

    queue = deque([source])
    paths = {source: []}
    while queue:
        u = queue.popleft()
        for v in all_vertices:
            # Остаточная пропускная способность ребра u->v
            cap = C.get(u, {}).get(v, 0)
            residual = cap - F[u][v]
            if residual > 0 and v not in paths:
                paths[v] = paths[u] + [(u, v)]
                if v == sink:
                    return paths[v]
                queue.append(v)
    return None

# Более простая и правильная реализация BFS, основанная на представлении
# остаточной сети через словарь residual, который мы строим на лету.
# Перепишем BFS для ясности:

def bfs_correct(C, F, source, sink):
    """
    BFS по остаточной сети с учётом как прямых, так и обратных рёбер.
    """
    queue = deque([source])
    parent = {}          # для восстановления пути храним предыдущую вершину
    parent[source] = None

    while queue:
        u = queue.popleft()
        # Перебираем всех возможных соседей:
        # 1) Прямые рёбра из C
        for v, cap in C.get(u, {}).items():
            if cap - F[u][v] > 0 and v not in parent:
                parent[v] = u
                if v == sink:
                    # восстанавливаем путь
                    path = []
                    cur = sink
                    while cur != source:
                        prev = parent[cur]
                        path.append((prev, cur))
                        cur = prev
                    return list(reversed(path))
                queue.append(v)
        # 2) Обратные рёбра: если есть поток из v в u, то ребро u<-v (т.е. v->u)
        # в остаточной сети имеет пропускную способность F[v][u] (положительную)
        # Мы можем перебрать все вершины, для которых F[v][u] > 0.
        # Но проще пройтись по всем v, где F[v][u] > 0.
        # Однако словарь F хранит только те рёбра, где был ненулевой поток.
        # Поэтому перебираем все ключи в F:
        for v in F.keys():
            if F[v].get(u, 0) > 0 and v not in parent:
                # Ребро v->u в остаточной сети имеет пропускную способность F[v][u]
                # Но нам нужно ребро u->v? Нет: из u мы можем пойти в v,
                # если существует обратное ребро v->u в исходной сети? Запутались.
                # Правило: ребро (u, v) существует в остаточной сети, если:
                # - (u,v) прямое и C[u][v] - F[u][v] > 0, либо
                # - (v,u) прямое и F[v][u] > 0 (тогда остаточное ребро (u,v) имеет пропускную способность F[v][u]).
                # То есть, для каждого v, для которого F[v][u] > 0, мы можем добавить ребро u->v.
                # Но в нашем переборе мы рассматриваем u как текущую вершину,
                # и ищем v, такие что есть обратный поток из v в u.
                # Условие: F[v][u] > 0.
                # Тогда остаточная пропускная способность u->v = F[v][u].
                if v not in parent:
                    parent[v] = u
                    if v == sink:
                        # восстановление пути
                        path = []
                        cur = sink
                        while cur != source:
                            prev = parent[cur]
                            path.append((prev, cur))
                            cur = prev
                        return list(reversed(path))
                    queue.append(v)
    return None

# В целях простоты и надёжности, перепишем весь алгоритм, используя
# единый подход: будем хранить остаточную сеть как отдельный словарь
# или использовать матрицу смежности. Для данного небольшого графа
# проще всего использовать словарь остаточных пропускных способностей
# и обновлять его на каждом шаге. Это и есть классическая реализация Эдмондса-Карпа.

# Реализуем с нуля, с понятными комментариями:

def edmonds_karp(graph, source, sink):
    """
    Алгоритм Эдмондса-Карпа для нахождения максимального потока.
    
    graph: словарь, где graph[u][v] = пропускная способность ребра u->v.
           Обратные рёбра не задаются, они появятся в остаточной сети.
    source, sink: вершины исток и сток.
    
    Возвращает:
        max_flow (int) и словарь flow, где flow[u][v] = поток по ребру u->v.
    """
    # Инициализируем остаточную сеть residual как копию исходных пропускных способностей
    residual = {}
    for u in graph:
        residual[u] = {}
        for v, cap in graph[u].items():
            residual[u][v] = cap
        # также добавим обратные рёбра с нулевой пропускной способностью
        # для удобства (они будут увеличиваться при уменьшении потока)
        for v in graph:
            if v not in residual[u]:
                residual[u][v] = 0

    # Добавим все вершины в residual, чтобы не было KeyError
    all_vertices = set(graph.keys())
    for u in graph:
        all_vertices.update(graph[u].keys())
    for u in all_vertices:
        if u not in residual:
            residual[u] = {}
        for v in all_vertices:
            if v not in residual[u]:
                residual[u][v] = 0

    flow = defaultdict(lambda: defaultdict(int))
    max_flow = 0

    while True:
        # BFS для поиска пути в остаточной сети
        parent = {}
        parent[source] = None
        queue = deque([source])
        found = False
        while queue and not found:
            u = queue.popleft()
            for v in all_vertices:
                if residual[u][v] > 0 and v not in parent:
                    parent[v] = u
                    if v == sink:
                        found = True
                        break
                    queue.append(v)
            if found:
                break
        if not found:
            break   # увеличивающего пути нет

        # Находим минимальную остаточную пропускную способность вдоль пути
        path_flow = float('inf')
        v = sink
        while v != source:
            u = parent[v]
            path_flow = min(path_flow, residual[u][v])
            v = u

        # Обновляем остаточную сеть и поток
        v = sink
        while v != source:
            u = parent[v]
            residual[u][v] -= path_flow
            residual[v][u] += path_flow   # обратное ребро
            flow[u][v] += path_flow       # увеличиваем прямой поток
            flow[v][u] -= path_flow       # уменьшаем обратный (для учёта)
            v = u

        max_flow += path_flow

    return max_flow, flow

# Исходный граф по заданию
C = {
    0: {1: 16, 2: 13},
    1: {2: 10, 3: 12},
    2: {4: 14},
    3: {2: 9, 5: 20},
    4: {3: 7, 5: 4}
}

source = 0
sink = 5

max_flow, flow = edmonds_karp(C, source, sink)

print("Максимальный поток:", max_flow)
print("\nПоток по рёбрам исходной сети:")
# Выводим поток только для рёбер, заданных в C
for u in C:
    for v in C[u]:
        # чистый поток по ребру u->v = flow[u][v] (он уже учтён)
        print(f"  {u} -> {v} : {flow[u][v]}")

# Нахождение минимального разреза
# Выполняем BFS в остаточной сети из истока по рёбрам с положительной остаточной пропускной способностью
# Остаточная сеть после завершения алгоритма - это residual (мы её не сохранили в функции)
# Переделаем функцию, чтобы она возвращала также residual, или вычислим заново.

def min_cut(graph, flow, source):
    """
    Находит минимальный разрез по завершении алгоритма Эдмондса-Карпа.
    graph: исходный граф с пропускными способностями
    flow: словарь потоков
    source: исток
    Возвращает (достижимые_вершины, рёбра_разреза, пропускная_способность_разреза)
    """
    # Построим остаточную сеть: для каждого ребра (u,v) из graph,
    # остаточная пропускная способность = graph[u][v] - flow[u][v]
    # также обратные рёбра имеют пропускную способность flow[v][u] (если положительна)
    all_vertices = set(graph.keys()) | set(flow.keys())
    for u in graph:
        all_vertices.update(graph[u].keys())
    for u in flow:
        all_vertices.update(flow[u].keys())

    residual = defaultdict(lambda: defaultdict(int))
    for u in all_vertices:
        for v in all_vertices:
            # прямое ребро
            if u in graph and v in graph[u]:
                residual[u][v] = graph[u][v] - flow[u][v]
            # обратное ребро (появляется из потока)
            if flow[v][u] > 0:
                residual[u][v] += flow[v][u]

    # BFS из истока
    visited = set()
    queue = deque([source])
    visited.add(source)
    while queue:
        u = queue.popleft()
        for v in all_vertices:
            if residual[u][v] > 0 and v not in visited:
                visited.add(v)
                queue.append(v)

    # Рёбра разреза: идут из visited в не посещённые
    cut_edges = []
    cut_capacity = 0
    for u in visited:
        for v in all_vertices:
            if v not in visited:
                # если есть ребро в исходном графе из u в v
                if u in graph and v in graph[u]:
                    cut_edges.append((u, v, graph[u][v]))
                    cut_capacity += graph[u][v]
    return visited, cut_edges, cut_capacity

visited, cut_edges, cut_capacity = min_cut(C, flow, source)

print("\nМинимальный разрез:")
print("  Множество S (достижимые из истока в остаточной сети):", sorted(visited))
print("  Множество T:", sorted(set(C.keys()) | set(range(6)) - visited))
print("  Рёбра разреза (из S в T):")
for u, v, cap in cut_edges:
    print(f"    {u} -> {v} (пропускная способность {cap})")
print(f"  Пропускная способность разреза = {cut_capacity}")
print(f"  Величина максимального потока = {max_flow}")
print("  Согласно теореме max-flow min-cut, эти величины равны.")

# Объяснение теоремы
print("\n" + "="*60)
print("ТЕОРЕМА МАКСИМАЛЬНОГО ПОТОКА И МИНИМАЛЬНОГО РАЗРЕЗА (max-flow min-cut)")
print("="*60)
print("""
Формулировка:
    В любой транспортной сети величина максимального потока из истока в сток
    равна пропускной способности минимального разреза, отделяющего исток от стока.

Пояснение:
    - Разрез (S, T) — это разбиение множества всех вершин на две части такие,
      что исток ∈ S, сток ∈ T. Пропускная способность разреза — сумма пропускных
      способностей рёбер, идущих из S в T.
    - Любой поток из истока в сток не может превысить пропускную способность
      любого разреза, поскольку все единицы потока, покидающие S, должны
      пройти через рёбра разреза (закон сохранения потока в вершинах S).
    - Алгоритм Форда-Фалкерсона (и его реализация Эдмондса-Карпа) строит поток,
      после которого в остаточной сети нет пути из истока в сток. Множество
      вершин, достижимых из истока в остаточной сети, образует разрез (S, T),
      пропускная способность которого равна величине построенного потока.
      Следовательно, этот разрез — минимальный, а поток — максимальный.

В нашем примере:
    Максимальный поток = {max_flow}
    Минимальный разрез имеет пропускную способность = {cut_capacity}
    Равенство подтверждает теорему.
""".format(max_flow=max_flow, cut_capacity=cut_capacity))
