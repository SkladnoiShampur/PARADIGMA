## T(n) = T(n/2) + O(log n), — это модифицированный бинарный поиск с дополнительной логарифмической работой на каждом шаге.

def modified_binary_search(arr, left, right, target):
    if left >= right:
        return -1  # Элемент не найден
    
    mid = (left + right) // 2
    
    # Дополнительная работа O(log n) на каждом шаге (например, сортировка части массива)
    additional_work(arr, left, right)  # Функция, выполняющая O(log n) операций
    
    if arr[mid] == target:
        return mid
    elif arr[mid] > target:
        return modified_binary_search(arr, left, mid, target)
    else:
        return modified_binary_search(arr, mid + 1, right, target)

