## Построение массива префиксных сумм

import time

def build_prefix_sum(arr):
    ## Строим массив префиксных сумм для заданного массива.
    start = time.time()
    n = len(arr)
    if n == 0:
        return []
    
    prefix = [0] * n
    prefix[0] = arr[0]
    
    for i in range(1, n):
        prefix[i] = prefix[i - 1] + arr[i]
    
    return prefix, time.time() - start
def sum_in_range(prefix, l, r):
    ## Вычисляем сумму элементов на отрезке [l, r] за O(1).
    if l == 0:
        return prefix[r]
    else:
        return prefix[r] - prefix[l - 1]
# Исходный массив
arr = list(map(int, input("Введите числа через пробел: ").split()))
## arr = [1, 3, -2, 8, 5]

# Строим префиксные суммы
prefix = build_prefix_sum(arr)
print("Исходный массив:", arr)
print("Префиксные суммы:", prefix)
# Вывод: [1, 4, 2, 10, 15]

# Выполняем запросы
print("Сумма [0, 2]:", sum_in_range(prefix, 0, 2))  # 1 + 3 + (-2) = 2
print("Сумма [1, 3]:", sum_in_range(prefix, 1, 3))  # 3 + (-2) + 8 = 9
print("Сумма [2, 4]:", sum_in_range(prefix, 2, 4))  # (-2) + 8 + 5 = 11

sizes = [10000, 20000, 40000, 1000000, 10000000]
results_time = []

for size in sizes:
    data = [str(i % 100) for i in range(size)]  ## Тестовые данные
    results_time.append(build_prefix_sum(data))

print(results_time)


""" Анализ сложности
Временная сложность: O(n), так как:
Алгоритм выполняет один проход по массиву длины n.
На каждой итерации выполняется константное число операций (сложение и присваивание).
Общее число операций пропорционально n: T(n)=c⋅n, где c — константа.
Дополнительная пространственная сложность: O(n), так как:
Создаётся новый массив prefix длины n, который требует O(n) дополнительной памяти.
Все остальные переменные (счётчики, временные значения) занимают O(1) памяти.
Итого: S(n)=O(n)+O(1)=O(n)."""
