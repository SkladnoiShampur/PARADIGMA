## Построение массива префиксных сумм

def build_prefix_sum(arr):
    ## Строим массив префиксных сумм для заданного массива.
    n = len(arr)
    if n == 0:
        return []
    
    prefix = [0] * n
    prefix[0] = arr[0]
    
    for i in range(1, n):
        prefix[i] = prefix[i - 1] + arr[i]
    
    return prefix
def query_range_sum(prefix, l, r):
    ## Вычисляем сумму элементов на отрезке [l, r] за O(1).
    if l == 0:
        return prefix[r]
    else:
        return prefix[r] - prefix[l - 1]
# Исходный массив
arr = [1, 3, -2, 8, 5]

# Шаг 1: строим префиксные суммы
prefix = build_prefix_sum(arr)
print("Исходный массив:", arr)
print("Префиксные суммы:", prefix)
# Вывод: [1, 4, 2, 10, 15]

# Шаг 2: выполняем запросы за O(1)
print("Сумма [0, 2]:", query_range_sum(prefix, 0, 2))  # 1 + 3 + (-2) = 2
print("Сумма [1, 3]:", query_range_sum(prefix, 1, 3))  # 3 + (-2) + 8 = 9
print("Сумма [2, 4]:", query_range_sum(prefix, 2, 4))  # (-2) + 8 + 5 = 11
