# =============================================================================
# ЗАДАНИЕ 9. CAC (Customer Acquisition Cost) — стоимость привлечения клиента
# =============================================================================

# CAC (Customer Acquisition Cost) — стоимость привлечения одного нового клиента.
# Показывает, сколько в среднем компания тратит, чтобы получить одного платящего
# (или целевого) клиента.

# Отличие от CPI и CPA:
#   CPI (Cost Per Install) — стоимость одной установки приложения. Считается только
#   по рекламе: бюджет / число установок. Клиент ещё не обязан покупать.
#   CPA (Cost Per Action) — стоимость целевого действия (регистрация, заявка, покупка
#   и т.д.). Действие задаётся в кампании; это не всегда «новый клиент».
#   CAC — полная стоимость именно нового клиента: в расчёт часто входят не только
#   реклама, но и продажи, зарплаты, инструменты и др. (см. ниже).

# В CAC кроме рекламного бюджета могут включать:
#   — расходы на отдел продаж (зарплаты, бонусы, CRM);
#   — маркетинг вне рекламы (контент, мероприятия, PR);
#   — зарплаты маркетологов и аналитиков;
#   — подписки на сервисы (аналитика, email, хостинг);
#   — производство креативов, агентские услуги;
#   — онбординг и поддержка на этапе привлечения (если относят к acquisition).

# Январь: 500 000 руб. / 250 клиентов = 2 000 руб. на клиента
# Февраль: 400 000 руб. / 320 клиентов = 1 250 руб. на клиента
#
# CAC снизился с 2 000 до 1 250 руб. (на 750 руб., или на 37,5%).
# При меньших затратах и большем числе клиентов привлечение стало эффективнее.

def calculate_cac(marketing_spend, sales_spend, new_customers):
    """
    Считает CAC: (маркетинг + продажи) / число новых клиентов.

    marketing_spend — расходы на маркетинг (руб.)
    sales_spend     — расходы на продажи (руб.)
    new_customers   — количество новых клиентов
    """
    if new_customers == 0:
        return 0.0  # защита от деления на ноль
    total_spend = marketing_spend + sales_spend
    cac = total_spend / new_customers
    return cac


def cac_trend(monthly_data):
    """
    По списку месяцев считает CAC и выводит динамику к прошлому месяцу.

    monthly_data — список словарей, например:
        [
            {"month": "Январь", "marketing": 400000, "sales": 100000, "customers": 250},
            {"month": "Февраль", "marketing": 320000, "sales": 80000, "customers": 320},
        ]
    """
    previous_cac = None

    for record in monthly_data:
        month = record["month"]
        marketing = record["marketing"]
        sales = record["sales"]
        customers = record["customers"]

        cac = calculate_cac(marketing, sales, customers)

        if previous_cac is None:
            # Первый месяц — с чем сравнивать нечего
            trend_text = "-"
        elif cac > previous_cac:
            trend_text = "↑ растёт (плохо)"
        elif cac < previous_cac:
            trend_text = "↓ снижается (хорошо)"
        else:
            trend_text = "→ без изменений"

        print(f"{month}: CAC = {cac} руб. {trend_text}")
        previous_cac = cac


if __name__ == "__main__":
  print("--- calculate_cac ---")
  print(calculate_cac(400000, 100000, 250), "руб.")   # ожидается: 2000.0 руб.
  print(calculate_cac(320000, 80000, 320), "руб.")    # ожидается: 1250.0 руб.

  print("\n--- cac_trend ---")
  data = [
      {"month": "Январь", "marketing": 400000, "sales": 100000, "customers": 250},
      {"month": "Февраль", "marketing": 320000, "sales": 80000, "customers": 320},
  ]
  cac_trend(data)
