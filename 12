import java.util.*;
import java.util.stream.Collectors;

public class Main {

    // Модель студента
    static class Student {
        private final int id;
        private final String name;
        private final int age;
        private final double gpa;

        Student(int id, String name, int age, double gpa) {
            this.id = id;
            this.name = name;
            this.age = age;
            this.gpa = gpa;
        }

        int getId() {
            return id;
        }

        String getName() {
            return name;
        }

        int getAge() {
            return age;
        }

        double getGpa() {
            return gpa;
        }

        @Override
        public String toString() {
            return String.format("Student{id=%d, name='%s', age=%d, gpa=%.1f}", id, name, age, gpa);
        }
    }

    // Базовый интерфейс спецификации
    interface Specification<T> {
        boolean isSatisfiedBy(T entity);

        // Комбинирование спецификаций через default-методы (Java 8+)
        default Specification<T> and(Specification<T> other) {
            return new AndSpecification<>(this, other);
        }

        default Specification<T> or(Specification<T> other) {
            return new OrSpecification<>(this, other);
        }

        default Specification<T> not() {
            return new NotSpecification<>(this);
        }
    }

    // Интерфейс репозитория
    interface Repository<T, ID> {
        T save(T entity);
        Optional<T> findById(ID id);
        List<T> findAll();
        void delete(ID id);
        List<T> findAll(Specification<T> spec);
    }

    // InMemory-реализация репозитория студентов
    static class InMemoryStudentRepository implements Repository<Student, Integer> {
        private final Map<Integer, Student> storage = new LinkedHashMap<>();

        @Override
        public Student save(Student entity) {
            storage.put(entity.getId(), entity);
            return entity;
        }

        @Override
        public Optional<Student> findById(Integer id) {
            return Optional.ofNullable(storage.get(id));
        }

        @Override
        public List<Student> findAll() {
            return new ArrayList<>(storage.values());
        }

        @Override
        public void delete(Integer id) {
            storage.remove(id);
        }

        @Override
        public List<Student> findAll(Specification<Student> spec) {
            List<Student> result = new ArrayList<>();
            for (Student student : storage.values()) {
                if (spec.isSatisfiedBy(student)) {
                    result.add(student);
                }
            }
            return result;
        }
    }

    // Спецификация: возраст больше заданного
    static class AgeGreaterThan implements Specification<Student> {
        private final int age;

        AgeGreaterThan(int age) {
            this.age = age;
        }

        @Override
        public boolean isSatisfiedBy(Student entity) {
            return entity.getAge() > age;
        }
    }

    // Спецификация: имя содержит подстроку (без учета регистра)
    static class NameContains implements Specification<Student> {
        private final String text;

        NameContains(String text) {
            this.text = text.toLowerCase();
        }

        @Override
        public boolean isSatisfiedBy(Student entity) {
            return entity.getName().toLowerCase().contains(text);
        }
    }

    // Спецификация: GPA больше заданного
    static class GpaGreaterThan implements Specification<Student> {
        private final double gpa;

        GpaGreaterThan(double gpa) {
            this.gpa = gpa;
        }

        @Override
        public boolean isSatisfiedBy(Student entity) {
            return entity.getGpa() > gpa;
        }
    }

    // Комбинированная спецификация AND
    static class AndSpecification<T> implements Specification<T> {
        private final Specification<T> left;
        private final Specification<T> right;

        AndSpecification(Specification<T> left, Specification<T> right) {
            this.left = left;
            this.right = right;
        }

        @Override
        public boolean isSatisfiedBy(T entity) {
            return left.isSatisfiedBy(entity) && right.isSatisfiedBy(entity);
        }
    }

    // Комбинированная спецификация OR
    static class OrSpecification<T> implements Specification<T> {
        private final Specification<T> left;
        private final Specification<T> right;

        OrSpecification(Specification<T> left, Specification<T> right) {
            this.left = left;
            this.right = right;
        }

        @Override
        public boolean isSatisfiedBy(T entity) {
            return left.isSatisfiedBy(entity) || right.isSatisfiedBy(entity);
        }
    }

    // Комбинированная спецификация NOT
    static class NotSpecification<T> implements Specification<T> {
        private final Specification<T> wrapped;

        NotSpecification(Specification<T> wrapped) {
            this.wrapped = wrapped;
        }

        @Override
        public boolean isSatisfiedBy(T entity) {
            return !wrapped.isSatisfiedBy(entity);
        }
    }

    public static void main(String[] args) {
        InMemoryStudentRepository repository = new InMemoryStudentRepository();

        // Добавляем 10 студентов
        repository.save(new Student(1, "Ivan Petrov", 19, 3.8));
        repository.save(new Student(2, "Anna Smirnova", 22, 4.6));
        repository.save(new Student(3, "Sergey Ivanov", 21, 4.2));
        repository.save(new Student(4, "Elena Kozlova", 20, 3.0));
        repository.save(new Student(5, "Daniil Romanov", 23, 4.9));
        repository.save(new Student(6, "Maria Sokolova", 18, 4.4));
        repository.save(new Student(7, "Anton Lebedev", 24, 2.9));
        repository.save(new Student(8, "Nikita Fedorov", 20, 3.7));
        repository.save(new Student(9, "Anastasia Belova", 25, 4.1));
        repository.save(new Student(10, "Pavel Morozov", 22, 3.2));

        // Запрос 1: age > 20
        Specification<Student> q1 = new AgeGreaterThan(20);
        printQuery("findAll(age > 20)", repository.findAll(q1));

        // Запрос 2: gpa > 4.0
        Specification<Student> q2 = new GpaGreaterThan(4.0);
        printQuery("findAll(gpa > 4.0)", repository.findAll(q2));

        // Запрос 3: age > 20 AND gpa > 4.0
        Specification<Student> q3 = new AgeGreaterThan(20).and(new GpaGreaterThan(4.0));
        printQuery("findAll(age > 20 AND gpa > 4.0)", repository.findAll(q3));

        // Запрос 4: name contains \"an\" OR gpa > 4.5
        Specification<Student> q4 = new NameContains("an").or(new GpaGreaterThan(4.5));
        printQuery("findAll(name contains \"an\" OR gpa > 4.5)", repository.findAll(q4));

        // Запрос 5: NOT(gpa > 3.0)
        Specification<Student> q5 = new GpaGreaterThan(3.0).not();
        printQuery("findAll(NOT(gpa > 3.0))", repository.findAll(q5));
    }

    // Утилита для красивого вывода результатов запроса
    private static void printQuery(String title, List<Student> students) {
        System.out.println("\n" + title + ": " + students.size() + " students");
        String result = students.stream()
                .map(Student::toString)
                .collect(Collectors.joining("\n"));
        System.out.println(result.isEmpty() ? "(empty)" : result);
    }
}
